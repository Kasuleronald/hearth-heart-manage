# Copy this to .env and fill in real values. Never commit .env.

# Used by drizzle-kit to generate/run migrations — must be a role that owns
# the schema (full DDL rights). On a fresh Postgres this is usually the
# default superuser you created the database with.
DATABASE_URL_MIGRATE=postgres://postgres:postgres@localhost:5432/mychurch

# Used by the running app (src/server/db/client.ts) — must be the separate
# `app_user` role created by scripts/db-setup.sql (DML only, no DDL, no
# table ownership), so the Row-Level Security tenant-isolation policies in
# src/server/db/schema.ts actually apply to it.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/mychurch

# Random 32+ byte secret used to sign the session cookie's opaque id. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cookie is only marked Secure (HTTPS-only) when this is "production" — leave
# unset for local dev over http://localhost.
NODE_ENV=development

# Set to "false" to temporarily allow the session cookie over plain HTTP —
# only needed for a production deploy that doesn't have a domain + TLS cert
# yet (a Secure cookie is silently dropped by the browser over HTTP, which
# makes login appear to succeed while no session is ever kept). Remove this
# once certbot is set up so the cookie goes back to Secure-only.
# COOKIE_SECURE=false

# The site's own public base URL, used to build links inside emails (e.g.
# https://your-domain.example, or http://<vm-ip> before you have a domain).
# Leave unset to skip emailing invite links entirely — they still show in
# the SuperAdmin UI as a manual-relay fallback either way.
APP_URL=

# Optional — invite emails are only sent if all of SMTP_HOST/USER/PASS are
# set; otherwise src/server/email.ts logs and skips, no error. For Gmail:
# smtp.gmail.com, port 587, and an App Password (requires 2-Step Verification
# on the account) from https://myaccount.google.com/apppasswords — not your
# regular Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
