# Copy this to .env and fill in real values. Never commit .env.

# Used by drizzle-kit to generate/run migrations — must be a role that owns
# the schema (full DDL rights). On a fresh Postgres this is usually the
# default superuser you created the database with.
DATABASE_URL_MIGRATE=postgres://postgres:postgres@localhost:5432/mychurch

# Used by the running app (src/server/db/client.ts) — must be the separate
# `app_user` role created by scripts/db-setup.sql (DML only, no DDL, no
# table ownership), so the Row-Level Security tenant-isolation policies in
# src/server/db/schema.ts actually apply to it.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/mychurch

# Random 32+ byte secret used to sign the session cookie's opaque id. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cookie is only marked Secure (HTTPS-only) when this is "production" — leave
# unset for local dev over http://localhost.
NODE_ENV=development
